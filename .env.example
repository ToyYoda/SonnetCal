# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sonnetcal"

# Auth
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
SESSION_DURATION_DAYS=30

# WhatsApp via Twilio
# Get credentials at https://console.twilio.com
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-auth-token"
# Twilio Sandbox: whatsapp:+14155238886  |  Production: your approved number
TWILIO_WHATSAPP_FROM="+14155238886"

# KI-Analyse (Ollama lokal)
# Ollama muss laufen: https://ollama.com
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_VISION_MODEL="llama3.2-vision"

# WhatsApp Webhook Verification Token (beliebiger String)
WHATSAPP_WEBHOOK_TOKEN="your-webhook-verify-token"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
